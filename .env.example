# Public URL of the app (used in emails and Google redirects). Use https:// in production.
APP_URL=http://localhost:3000

# Optional: SQLite file location (default: ./data/everyday.db)
# DATABASE_PATH=./data/everyday.db

# Welcome emails via Resend (https://resend.com). Without a key, emails are only logged
# and stored in the `outbox` table. MAIL_FROM must be a sender verified in Resend.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Orqivio AI <hello@yourdomain.com>

# "Continue with Google" (https://console.cloud.google.com/apis/credentials, OAuth client, Web application).
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# The button only appears when both values are set.
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# Real AI (https://console.anthropic.com). Without a key the app runs on the built-in simulation.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: model (default claude-opus-5-5). Cheaper: claude-sonnet-5-5
# AI_MODEL=claude-opus-5-5
# Optional: set to "off" to disable server-side refusal fallbacks
# AI_FALLBACK=off
